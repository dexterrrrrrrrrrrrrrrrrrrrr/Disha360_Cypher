NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/cypher?retryWrites=true&w=majority

# Enable only behind one trusted reverse proxy; production requires HTTPS.
TRUST_PROXY=false
# Use none for direct cross-site HTTPS Vercel -> Render; lax for same-site domains.
COOKIE_SAME_SITE=lax
# Optional development seeding: set privately, never use a default password.
SEED_DEMO_PASSWORD=
# Coding samples: opt in to a dedicated development database before seed:coding.
# MONGODB_URI must explicitly select this same database (e.g. /disha360_dev).
# Never use a database containing production data. Blank disables the seed command.
CODING_SEED_DATABASE=
# Optional operator-only staff provisioning; remove after use.
PROVISION_NAME=
PROVISION_EMAIL=
PROVISION_ROLE=
PROVISION_PASSWORD=
# Required only for user:create -- --development; must match the URI database.
PROVISION_DATABASE=

# Optional OpenAI alternative: backend only; select AI_PROVIDER=openai explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional trusted Judge0 CE execution provider (backend only).
# HTTPS required, except loopback HTTP for local protocol/testing infrastructure.
JUDGE0_URL=
JUDGE0_API_KEY=
# Set true ONLY after verifying patched sandboxing, cgroup limits, filesystem isolation,
# disabled outbound network, and the four supported language IDs. Presence is not proof.
JUDGE0_SECURITY_CONFIRMED=false

# Explicit company samples: same dedicated database requirement as coding seeding.
COMPANY_SEED_DATABASE=

# Development-only illustrative coding workflow; never executes or grades code.
CODING_DEMO_MODE=false

# Backend-only AI provider selection. No automatic provider/model/key fallbacks.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
# REQUIRED: set a model verified against current official Free Tier pricing.
# Deliberately blank: no unverified or paid model is selected automatically.
GEMINI_MODEL=
# Manual selection only; changing this requires a backend restart.
GEMINI_KEY_SELECTION=primary

# Direct OneCompiler API, backend only. Explicit opt-in; no paid tests or fallback.
ONECOMPILER_API_KEY=
ONECOMPILER_ENABLED=false
# Per-process UTC daily testcase-attempt cap, NOT a provider credit/rupee cap.
ONECOMPILER_MAX_EXECUTIONS_PER_DAY=100
# SparkMeet uses the fixed approved origin https://sparkmeet-web.onrender.com.
# Paste actual meeting links in authorized class forms; no API keys or embed tokens.
