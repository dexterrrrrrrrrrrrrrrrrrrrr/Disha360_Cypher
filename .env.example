# Copy this file to server/.env. Values are placeholders, not credentials.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Create an Atlas database user and replace the placeholders. URI-encode credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/cypher?retryWrites=true&w=majority

# Enable only behind one trusted reverse proxy; production requires HTTPS.
TRUST_PROXY=false
# Optional development seeding: set privately, never use a default password.
SEED_DEMO_PASSWORD=
# Optional operator-only staff provisioning; remove after use.
PROVISION_NAME=
PROVISION_EMAIL=
PROVISION_ROLE=
PROVISION_PASSWORD=
